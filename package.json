  "scripts": {
    "install-deps": "npm install dotenv-cli cross-var concurrently vite eslint json-server",
    "dev": "cross-var concurrently \"vite --host=0.0.0.0 --port=3000\" \"json-server --watch languagesgpt_db_dev.json --port=8000\"",
